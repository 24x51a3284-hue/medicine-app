# ─────────────────────────────────────────────────────────────────
# MediFind — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to Git!
# ─────────────────────────────────────────────────────────────────

# ── SERVER ───────────────────────────────────────────────────────
PORT=5000

# ── REQUIRED: Security ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_key_change_this_123

# ── REQUIRED: Database (free at mongodb.com/cloud/atlas) ─────────
# Without this the app saves data only in local database.json,
# which gets wiped on every server restart/deploy.
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/medifind

# ── YOUR APP URL (for self-ping to prevent sleep) ────────────────
APP_URL=https://medicine-app-o0we.onrender.com

# ── EMAIL (Free Gmail setup) ──────────────────────────────────────
# 1. Go to myaccount.google.com → Security → App Passwords
# 2. Create App Password for "Mail"
# 3. Paste the 16-char password below (NOT your Gmail password!)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password

# ── RAZORPAY (Free test account) ─────────────────────────────────
# 1. Go to https://dashboard.razorpay.com/app/keys
# 2. Generate Test keys first (free, no real money)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── TWILIO (Phone OTP login — optional) ──────────────────────────
# Without these, OTP works in demo mode (OTP shown on screen).
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# ── GOOGLE LOGIN (optional) ──────────────────────────────────────
# Create OAuth Client ID at console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── CLOUDINARY (Prescription cloud storage — optional) ───────────
# Without these, prescriptions are stored locally in uploads/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── WEB PUSH NOTIFICATIONS (optional) ────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
