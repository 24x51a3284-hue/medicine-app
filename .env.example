# ── REQUIRED ─────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_change_this_123

# ── YOUR APP URL (for self-ping to prevent sleep) ─────────────────
APP_URL=https://medicine-app-o0we.onrender.com

# ── EMAIL (Free Gmail setup) ──────────────────────────────────────
# 1. Go to myaccount.google.com → Security → App Passwords
# 2. Create App Password for "Mail"
# 3. Paste the 16-char password below (NOT your Gmail password!)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password

# ── RAZORPAY (Free to register) ───────────────────────────────────
# 1. Go to https://dashboard.razorpay.com/app/keys
# 2. Generate Test keys first (free, no real money)
# 3. When ready to go live, use Live keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
